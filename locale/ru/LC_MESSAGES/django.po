# ===== views.py — HomeView meta =====
msgid "PrometeyLabs - Розробка сайтів під ключ | Telegram боти | Реклама"
msgstr "PrometeyLabs - Разработка сайтов под ключ | Telegram боты | Реклама"

msgid ""
"PrometeyLabs - професійна розробка сайтів під ключ, створення Telegram "
"ботів, налаштування реклами Google Ads, навчання веб-розробки. Сучасні "
"технології, конкурентні ціни."
msgstr ""
"PrometeyLabs - профессиональная разработка сайтов под ключ, создание "
"Telegram ботов, настройка рекламы Google Ads, обучение веб-разработке. "
"Современные технологии, конкурентные цены."

msgid "PrometeyLabs - Розробка сайтів під ключ"
msgstr "PrometeyLabs - Разработка сайтов под ключ"

msgid "Портфоліо | Створені нами сайти під ключ - PrometeyLabs"
msgstr "Портфолио | Созданные нами сайты под ключ - PrometeyLabs"

msgid ""
"Портфоліо PrometeyLabs — сучасні веб-рішення під ключ для вашого бізнесу."
msgstr ""
"Портфолио PrometeyLabs — современные веб-решения под ключ для вашего бизнеса."

msgid "Розрахувати вартість сайту | Калькулятор ціни - PrometeyLabs"
msgstr "Рассчитать стоимость сайта | Калькулятор цены - PrometeyLabs"

msgid ""
"Розрахуйте вартість створення сайту онлайн. Сучасні технології знижують ціну "
"розробки. Тест для точного розрахунку вартості проекту."
msgstr ""
"Рассчитайте стоимость создания сайта онлайн. Современные технологии снижают "
"цену разработки. Тест для точного расчета стоимости проекта."

msgid "Контакти | PrometeyLabs - Зв'яжіться з нами"
msgstr "Контакты | PrometeyLabs - Свяжитесь с нами"

msgid ""
"Зв'яжіться з командою PrometeyLabs для розробки сайтів, Telegram ботів, "
"реклами чи навчання. Київ, Україна."
msgstr ""
"Свяжитесь с командой PrometeyLabs для разработки сайтов, Telegram ботов, "
"рекламы или обучения. Киев, Украина."

msgid "Публічна оферта на надання послуг | PrometeyLabs"
msgstr "Публичная оферта на предоставление услуг | PrometeyLabs"

msgid ""
"Публічна оферта на надання послуг від PrometeyLabs. Офіційні умови надання "
"послуг веб-розробки, мобільних застосунків та маркетингу."
msgstr ""
"Публичная оферта на предоставление услуг от PrometeyLabs. Официальные "
"условия предоставления услуг веб-разработки, мобильных приложений и "
"маркетинга."

msgid "Політика конфіденційності | PrometeyLabs"
msgstr "Политика конфиденциальности | PrometeyLabs"

msgid ""
"Політика конфіденційності PrometeyLabs. Дізнайтеся, як ми захищаємо ваші "
"персональні дані відповідно до законодавства України та GDPR."
msgstr ""
"Политика конфиденциальности PrometeyLabs. Узнайте, как мы защищаем ваши "
"персональные данные в соответствии с законодательством Украины и GDPR."

msgid "Політика щодо файлів cookie | PrometeyLabs"
msgstr "Политика в отношении файлов cookie | PrometeyLabs"

msgid ""
"Політика щодо файлів cookie від PrometeyLabs. Дізнайтеся, які файли cookie "
"ми використовуємо та як керувати налаштуваннями."
msgstr ""
"Политика в отношении файлов cookie от PrometeyLabs. Узнайте, какие файлы "
"cookie мы используем и как управлять настройками."

msgid "Політика повернення коштів | PrometeyLabs"
msgstr "Политика возврата средств | PrometeyLabs"

msgid ""
"Політика повернення коштів від PrometeyLabs. Дізнайтеся про умови і порядок "
"повернення коштів за наші послуги."
msgstr ""
"Политика возврата средств от PrometeyLabs. Узнайте об условиях и порядке "
"возврата средств за наши услуги."

msgid "Політика щодо інтелектуальної власності | PrometeyLabs"
msgstr "Политика в отношении интеллектуальной собственности | PrometeyLabs"

msgid ""
"Політика щодо інтелектуальної власності від PrometeyLabs. Дізнайтеся про "
"права на контент та захист авторських прав."
msgstr ""
"Политика в отношении интеллектуальной собственности от PrometeyLabs. Узнайте "
"о правах на контент и защите авторских прав."

